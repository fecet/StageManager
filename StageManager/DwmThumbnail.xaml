<UserControl
    x:Class="StageManager.DwmThumbnail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StageManager"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <!-- Near-zero-alpha backing (not fully Transparent): a sub-255 DWM thumbnail still
         blends with the screen behind for see-through, but alpha=1 keeps the pixels from
         becoming click-through on the layered window, so clicks on the preview reach the
         tile. alpha=0 would pass the click straight through to whatever is underneath. -->
    <Grid Background="#01000000" />
</UserControl>
