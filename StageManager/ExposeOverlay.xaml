<Window
    x:Class="StageManager.ExposeOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:StageManager"
    AllowsTransparency="True"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="Transparent"
    SizeToContent="WidthAndHeight"
    Title="Stage"
    Name="thisWindow">
    <Border
        Background="Transparent"
        Padding="6">
        <ScrollViewer
            x:Name="scroll"
            Background="Transparent"
            VerticalScrollBarVisibility="Hidden"
            HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="tilesControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- One grid unit. A tile spans one (88) or two (184, gap included),
                             always including the tile's 2px border on each side. -->
                        <local:MasonryPanel
                            UnitWidth="88"
                            Gap="8"
                            MaxColumnHeight="{Binding ColumnHeightLimit, ElementName=thisWindow}"
                            MaxColumns="{Binding ColumnLimit, ElementName=thisWindow}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            CornerRadius="6"
                            BorderThickness="2"
                            Background="#01000000"
                            Cursor="Hand"
                            MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FF3B82F6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Width="{Binding ThumbWidth}" Height="{Binding ThumbHeight}">
                                <!-- A live preview, or just the app icon when the window is
                                     minimized and DWM has no thumbnail left to mirror. -->
                                <local:DwmThumbnail
                                    ThumbnailOpacity="150"
                                    PreviewHandle="{Binding Handle}">
                                    <local:DwmThumbnail.Style>
                                        <Style TargetType="local:DwmThumbnail">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:DwmThumbnail.Style>
                                </local:DwmThumbnail>
                                <Image
                                    Source="{Binding Icon}"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Border
                                    Background="#B0000000"
                                    CornerRadius="4"
                                    Padding="4,2"
                                    Margin="0,4,0,0"
                                    MaxWidth="{Binding LabelMaxWidth}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Dropped on a minimized tile, whose whole face is
                                             already this same icon at 40px. -->
                                        <Image
                                            Source="{Binding Icon}"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,4,0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock
                                            Text="{Binding Title}"
                                            Foreground="White"
                                            FontSize="11"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
